{
    "name": "inventorycheck-frontend-qa",
    "private": true,
    "version": "1.3.6",
    "scripts": {
        "test": "node --test --test-concurrency=1 tests/js/*.test.mjs tests/js/*.test.cjs tests/js/*.e2e.test.mjs",
        "test:a11y": "node --test --test-concurrency=1 tests/a11y/*.test.mjs",
        "test:a11y:live": "playwright test tests/e2e/a11y-live.spec.mjs",
        "test:theme": "node --test --test-concurrency=1 tests/js/theme-tokens.test.mjs",
        "test:theme:live": "playwright test tests/e2e/theme-responsive-a11y.spec.mjs --project=chromium-1280",
        "e2e": "playwright test",
        "e2e:uat": "playwright test tests/e2e/uat-screenshots.spec.mjs --project=chromium-1280",
        "test:browser": "playwright test"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.10.2",
        "@playwright/test": "^1.55.0",
        "axe-core": "^4.10.2",
        "jsdom": "^26.1.0"
    },
    "engines": {
        "node": "^20.0.0 || ^22.0.0"
    }
}
