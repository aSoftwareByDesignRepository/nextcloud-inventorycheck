{
	"schemaVersion": 1,
	"appId": "inventorycheck",
	"companionDir": "mobile/inventorycheck",
	"contracts": [
		{
			"id": "adjust-reason-code",
			"param": "reasonCode",
			"description": "Adjust movements require a reasonCode from the fixed catalog whenever require_adjust_reason=1 (default). Server rejects with 422 reason_code_required / invalid_reason_code; web adjust form shows a select fed by GET /api/reason-codes; companion scan/bag review carries reasonCode per line.",
			"errorCodes": [
				"reason_code_required",
				"invalid_reason_code"
			],
			"server": [
				{
					"file": "lib/Service/ReasonCodes.php",
					"needles": [
						"requireForAdjust",
						"reason_code_required",
						"invalid_reason_code"
					]
				},
				{
					"file": "lib/Service/MovementService.php",
					"needles": [
						"ReasonCodes::requireForAdjust($this->config, $reasonCode)"
					]
				}
			],
			"web": [
				{
					"file": "js/app.js",
					"needles": [
						"reasonCode",
						"ctx.urls.api.reasonCodes"
					]
				}
			],
			"mobile": [
				{
					"file": "src/bag/buildBagScanRequest.ts",
					"needles": [
						"reasonCode: line.reasonCode?.trim() || null"
					]
				},
				{
					"file": "src/screens/ConfirmScreen.tsx",
					"needles": [
						"reasonCode"
					]
				}
			]
		},
		{
			"id": "location-scan-code",
			"param": "locationCode",
			"description": "When require_location_scan=1, scan/issue/transfer must confirm the from-location by scanning its barcode. Server enforces 422 location_code_required / location_code_mismatch via LocationScanPolicy::assertMatches; web scan form collects locationCode; companion ScanScreen/BagReview collects it per booking.",
			"errorCodes": [
				"location_code_required",
				"location_code_mismatch"
			],
			"server": [
				{
					"file": "lib/Service/LocationScanPolicy.php",
					"needles": [
						"assertMatches",
						"location_code_required",
						"location_code_mismatch"
					]
				},
				{
					"file": "lib/Controller/MobileController.php",
					"needles": [
						"locationCode",
						"location_code"
					]
				}
			],
			"web": [
				{
					"file": "js/app.js",
					"needles": [
						"locationCode",
						"name: 'locationCode'"
					]
				}
			],
			"mobile": [
				{
					"file": "src/screens/ScanScreen.tsx",
					"needles": [
						"locationCode"
					]
				},
				{
					"file": "src/bag/buildBagScanRequest.ts",
					"needles": [
						"locationCode: line.locationCode?.trim() || null"
					]
				}
			]
		},
		{
			"id": "to-location-scan-code",
			"param": "toLocationCode",
			"description": "Transfers under require_location_scan must also confirm the destination barcode (toLocationCode). Server validates via LocationScanPolicy::assertMatches with field toLocationCode; web transfer form collects it; companion carries it on transfer lines.",
			"errorCodes": [
				"location_code_required",
				"location_code_mismatch"
			],
			"server": [
				{
					"file": "lib/Service/LocationScanPolicy.php",
					"needles": [
						"toLocationCode",
						"location_code_required"
					]
				},
				{
					"file": "lib/Controller/MovementController.php",
					"needles": [
						"toLocationCodeParam",
						"to_location_code"
					]
				}
			],
			"web": [
				{
					"file": "js/app.js",
					"needles": [
						"toLocationCode",
						"transferBody.toLocationCode"
					]
				}
			],
			"mobile": [
				{
					"file": "src/screens/BagReviewScreen.tsx",
					"needles": [
						"toLocationCode"
					]
				}
			]
		},
		{
			"id": "cycle-count-qty-counted",
			"param": "qtyCounted",
			"description": "Counting a stocktake line posts PUT .../cycle-counts/lines/{id} with qtyCounted (integer >= 0). Server validates CycleCountSemantics::isQtyCountedValid -> 422; web stocktake table posts it; companion StocktakeDetailScreen sends it via client.setCycleCount.",
			"errorCodes": [
				"validation_failed"
			],
			"server": [
				{
					"file": "lib/Service/CycleCountService.php",
					"needles": [
						"qtyCounted",
						"isQtyCountedValid"
					]
				}
			],
			"web": [
				{
					"file": "js/app.js",
					"needles": [
						"qtyCounted",
						"cycleCountSetCount"
					]
				}
			],
			"mobile": [
				{
					"file": "src/api/client.ts",
					"needles": [
						"qtyCounted",
						"setCycleCount"
					]
				},
				{
					"file": "src/screens/StocktakeDetailScreen.tsx",
					"needles": [
						"qtyCounted"
					]
				}
			]
		},
		{
			"id": "scan-idempotency-key",
			"param": "clientRequestId",
			"description": "Companion scan bookings carry clientRequestId so retries replay the stored response instead of double-booking. Server claims/replays via ScanIdempotencyService (409 idempotency_in_flight / idempotency_payload_mismatch); web bookings are single-shot and do not use the key.",
			"errorCodes": [
				"idempotency_in_flight",
				"idempotency_payload_mismatch"
			],
			"server": [
				{
					"file": "lib/Controller/MobileController.php",
					"needles": [
						"clientRequestId",
						"client_request_id",
						"idempotency_payload_mismatch"
					]
				},
				{
					"file": "lib/Service/ScanIdempotencyService.php",
					"needles": [
						"normalizeClientRequestId",
						"tryClaim",
						"releaseStalePending"
					]
				}
			],
			"web": [],
			"mobile": [
				{
					"file": "src/bag/buildBagScanRequest.ts",
					"needles": [
						"clientRequestId"
					]
				},
				{
					"file": "src/screens/ConfirmScreen.tsx",
					"needles": [
						"clientRequestId"
					]
				}
			]
		},
		{
			"id": "device-token-header",
			"param": "X-IV-Device-Token",
			"description": "Paired scan devices authenticate every /mobile/v1 call with the X-IV-Device-Token header (hash compared server-side). Garbage tokens -> 401 auth_required; deactivated slots -> 402 device_required. Companion request layer sets the header from the paired session.",
			"errorCodes": [
				"auth_required",
				"device_required"
			],
			"server": [
				{
					"file": "lib/Controller/MobileController.php",
					"needles": [
						"X-IV-Device-Token",
						"findDeviceByTokenHash",
						"device_required"
					]
				}
			],
			"web": [],
			"mobile": [
				{
					"file": "src/api/request.ts",
					"needles": [
						"X-IV-Device-Token",
						"session.deviceToken"
					]
				}
			]
		},
		{
			"id": "stocktake-close-flags",
			"param": "abandonUncounted",
			"description": "Closing a stocktake accepts abandonUncounted (skip uncounted lines) and acknowledgeConflicts (book qty moved mid-count). Server enforces 422 count_incomplete / count_conflict without them; web close dialog sends both flags; companion close flow sends them on /mobile/v1 equivalent.",
			"errorCodes": [
				"count_incomplete",
				"count_conflict",
				"campaign_not_counting"
			],
			"server": [
				{
					"file": "lib/Controller/CycleCountController.php",
					"needles": [
						"abandonUncounted",
						"acknowledgeConflicts"
					]
				},
				{
					"file": "lib/Service/CycleCountService.php",
					"needles": [
						"count_incomplete",
						"count_conflict"
					]
				}
			],
			"web": [
				{
					"file": "js/app.js",
					"needles": [
						"abandonUncounted",
						"acknowledgeConflicts",
						"stocktakeCloseQuery"
					]
				}
			],
			"mobile": []
		},
		{
			"id": "device-pair-code",
			"param": "code",
			"description": "Pairing a scan device posts {code} to /mobile/v1/devices/pair; server rate-limits failures (429 rate_limited after 10/h/IP) and validates the hashed pair code. Admin settings web surface shows/regenerates the pairCode; companion PairDeviceScreen collects the code.",
			"errorCodes": [
				"invalid_pair_code",
				"rate_limited"
			],
			"server": [
				{
					"file": "lib/Controller/MobileController.php",
					"needles": [
						"pairDevice",
						"'code'"
					]
				},
				{
					"file": "lib/Service/DevicePairingService.php",
					"needles": [
						"pair(",
						"rate_limited"
					]
				}
			],
			"web": [
				{
					"file": "js/common/license-page.js",
					"needles": [
						"pairCode",
						"apiRegenDevice"
					]
				}
			],
			"mobile": [
				{
					"file": "src/screens/PairDeviceScreen.tsx",
					"needles": [
						"pairCode",
						"code"
					]
				}
			]
		},
		{
			"id": "stocktake-blind-mode",
			"param": "blind",
			"description": "Blind counting hides systemQty server-side: GET/PUT cycle-count responses strip book qty when blind=1 (AF-IV13). Web stocktake view toggles it; companion list/detail screens send blind on show/setCount.",
			"errorCodes": [],
			"server": [
				{
					"file": "lib/Controller/MobileController.php",
					"needles": [
						"blind",
						"systemQty"
					]
				}
			],
			"web": [
				{
					"file": "js/app.js",
					"needles": [
						"blind",
						"iv-stocktake-blind"
					]
				}
			],
			"mobile": [
				{
					"file": "src/api/client.ts",
					"needles": [
						"blind"
					]
				},
				{
					"file": "src/screens/StocktakeDetailScreen.tsx",
					"needles": [
						"blind"
					]
				}
			]
		},
		{
			"id": "item-total-qty",
			"param": "totalQty",
			"description": "Read-side response field: items list/detail/by-code carry totalQty = SUM(balances.qty) over actor-visible locations, display-scaled via QtyScale::formatItem. Never stripped by MoneyVisibility (quantity, not money); never client-summed from capped balance rows. Web renders it as the On hand column + item-detail Total line; mobile by-code inherits it automatically.",
			"errorCodes": [],
			"server": [
				{
					"file": "lib/Service/ItemService.php",
					"needles": [
						"'totalQty'",
						"sumQtyForItem",
						"sumQtyByItem"
					]
				},
				{
					"file": "lib/Db/BalanceMapper.php",
					"needles": [
						"sumQtyForItem",
						"sumQtyByItem"
					]
				},
				{
					"file": "lib/Service/QtyScale.php",
					"needles": [
						"'totalQty'"
					]
				}
			],
			"web": [
				{
					"file": "js/app.js",
					"needles": [
						"totalQty",
						"iv-balance-total",
						"tr('On hand')"
					]
				}
			],
			"mobile": [
				{
					"file": "src/types.ts",
					"needles": [
						"totalQty"
					]
				}
			]
		},
		{
			"id": "lot-fefo-picker",
			"param": "locationId",
			"description": "GET /api/items/{id}/lots returns FEFO-sorted lots with qty+state; the web issue dialog shows the picker (pre-selects earliest expiry, ?locationId= scopes the qty) and the companion client fetchItemLots uses the same shared endpoint.",
			"errorCodes": [
				"unknown_item",
				"unknown_location"
			],
			"server": [
				{
					"file": "lib/Controller/LotController.php",
					"needles": [
						"itemLots",
						"lotsWithStock"
					]
				},
				{
					"file": "lib/Service/LotService.php",
					"needles": [
						"sortFefo",
						"STATE_EXPIRING"
					]
				}
			],
			"web": [
				{
					"file": "js/app.js",
					"needles": [
						"data-iv-lot-picker",
						"ctx.urls.api.itemLots",
						"expires first"
					]
				}
			],
			"mobile": [
				{
					"file": "src/api/client.ts",
					"needles": [
						"fetchItemLots",
						"/lots"
					]
				},
				{
					"file": "src/types.ts",
					"needles": [
						"ItemLot",
						"expiresInDays"
					]
				}
			]
		},
		{
			"id": "expiry-warn-days",
			"param": "expiryWarnDays",
			"description": "Expiry watch window in days (0..365; 0 = watch off). POST /api/config validates via parseExpiryWarnDays and rejects with 422 validation_failed; GET /api/config returns expiryWarnDays; settings UI exposes the field with the 0=off hint.",
			"errorCodes": [
				"validation_failed"
			],
			"server": [
				{
					"file": "lib/Service/RestockConfig.php",
					"needles": [
						"parseExpiryWarnDays",
						"KEY_EXPIRY_WARN_DAYS"
					]
				},
				{
					"file": "lib/Controller/ConfigController.php",
					"needles": [
						"parseExpiryWarnDays",
						"expiryWarnDays"
					]
				}
			],
			"web": [
				{
					"file": "js/app.js",
					"needles": [
						"expiryWarnDays",
						"iv-expiry-days-hint"
					]
				}
			],
			"mobile": null
		},
		{
			"id": "reports-dead-stock-days",
			"param": "days",
			"description": "Dead-stock window (1..3650, default 90). GET /api/reports/dead-stock?days=N validates range and rejects with 422 validation_failed; the same param drives the dead_stock CSV export kind; /reports page exposes the number input with inline validation.",
			"errorCodes": [
				"validation_failed"
			],
			"server": [
				{
					"file": "lib/Controller/ReportController.php",
					"needles": [
						"deadStock",
						"'days'",
						"3650"
					]
				},
				{
					"file": "lib/Service/CsvExportService.php",
					"needles": [
						"exportDeadStock",
						"$days < 1 || $days > 3650"
					]
				}
			],
			"web": [
				{
					"file": "js/app.js",
					"needles": [
						"deadStockReport",
						"Untouched for at least (days)",
						"d < 1 || d > 3650"
					]
				}
			],
			"mobile": null
		},
		{
			"id": "product-lookup-barcode",
			"param": "barcode",
			"description": "GTIN product lookup (opt-in, office). POST /api/product-lookup validates the barcode and returns invalid_barcode/feature_disabled/rate_limited/unavailable; mobile POST /mobile/v1/product-lookup mirrors it.",
			"errorCodes": [
				"invalid_barcode",
				"feature_disabled",
				"rate_limited",
				"unavailable"
			],
			"server": [
				{
					"file": "lib/Controller/ProductLookupController.php",
					"needles": [
						"getParam('barcode'"
					]
				},
				{
					"file": "lib/Service/ProductLookupService.php",
					"needles": [
						"invalid_barcode"
					]
				}
			],
			"web": [
				{
					"file": "js/common/product-lookup.js",
					"needles": [
						"barcode"
					]
				}
			],
			"mobile": [
				{
					"file": "src/api/client.ts",
					"needles": [
						"postProductLookup",
						"barcode"
					]
				}
			]
		},
		{
			"id": "location-hierarchy",
			"param": "parentId",
			"description": "IV-SUB-LOCATIONS read+write field: locations carry parentId (nullable root link, depth cap 1) plus server-computed parentName/parentActive/pathLabel; web list shows pathLabel + parent picker (roots=1 endpoint), companion renders pathLabel on scan/confirm/location screens with name fallback. Server enforces validation_failed for non-root parent, self-parent, or reparenting a location that has children; delete returns location_has_children.",
			"errorCodes": [
				"validation_failed",
				"unknown_location",
				"location_has_children"
			],
			"server": [
				{
					"file": "lib/Service/LocationService.php",
					"needles": [
						"assertValidParent",
						"pathLabel",
						"location_has_children",
						"parseParentId",
						"parentsOf"
					]
				},
				{
					"file": "lib/Db/LocationMapper.php",
					"needles": [
						"findRoots",
						"hasChildren",
						"byIds",
						"parent_id"
					]
				},
				{
					"file": "lib/Service/LocationAclService.php",
					"needles": [
						"withDescendants"
					]
				},
				{
					"file": "lib/Db/Location.php",
					"needles": [
						"'parentId'"
					]
				}
			],
			"web": [
				{
					"file": "js/app.js",
					"needles": [
						"parentId",
						"pathLabel",
						"roots=1",
						"iv-loc-child",
						"iv-loc-parent-label"
					]
				}
			],
			"mobile": [
				{
					"file": "src/types.ts",
					"needles": [
						"parentId",
						"pathLabel"
					]
				},
				{
					"file": "src/screens/ConfirmScreen.tsx",
					"needles": [
						"pathLabel"
					]
				}
			]
		}
	]
}
